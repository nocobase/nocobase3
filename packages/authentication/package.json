{
  "name": "@nocobase/authentication",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage/collections/*": {
      "types": "./dist/storage/collections/*.d.ts",
      "import": "./dist/storage/collections/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nocobase/caching": "workspace:^",
    "@nocobase/database": "workspace:^",
    "better-auth": "^1.6.27",
    "hono": "^4.13.2",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  }
}
