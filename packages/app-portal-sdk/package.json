{
  "name": "@nocobase/app-portal-sdk",
  "version": "0.0.1-beta.0",
  "description": "Stable runtime and extension APIs for NocoBase Portal applications.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/portal-template-default.git",
    "directory": "packages/app-portal-sdk"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "MIGRATION.md"
  ],
  "exports": {
    "./compat": {
      "types": "./src/compat/index.ts",
      "import": "./src/compat/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts"
    },
    "./data": {
      "types": "./src/data/index.ts",
      "import": "./src/data/index.ts"
    },
    "./routing": {
      "types": "./src/routing/index.ts",
      "import": "./src/routing/index.ts"
    },
    "./extensions": {
      "types": "./src/extensions/index.ts",
      "import": "./src/extensions/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "import": "./src/i18n/index.ts"
    },
    "./system-settings": {
      "types": "./src/system-settings/index.ts",
      "import": "./src/system-settings/index.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts"
    },
    "./acl": {
      "types": "./src/acl/index.ts",
      "import": "./src/acl/index.ts"
    }
  },
  "bin": {
    "portal-sdk": "./scripts/cli.mjs"
  },
  "nocobase": {
    "supportedDefaultTemplateRange": ">=3.0.0 <4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./compat": {
        "types": "./dist/compat/index.d.ts",
        "import": "./dist/compat/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime/index.d.ts",
        "import": "./dist/runtime/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./auth": {
        "types": "./dist/auth/index.d.ts",
        "import": "./dist/auth/index.js"
      },
      "./data": {
        "types": "./dist/data/index.d.ts",
        "import": "./dist/data/index.js"
      },
      "./routing": {
        "types": "./dist/routing/index.d.ts",
        "import": "./dist/routing/index.js"
      },
      "./extensions": {
        "types": "./dist/extensions/index.d.ts",
        "import": "./dist/extensions/index.js"
      },
      "./i18n": {
        "types": "./dist/i18n/index.d.ts",
        "import": "./dist/i18n/index.js"
      },
      "./system-settings": {
        "types": "./dist/system-settings/index.d.ts",
        "import": "./dist/system-settings/index.js"
      },
      "./vite": {
        "types": "./dist/vite/index.d.ts",
        "import": "./dist/vite/index.js"
      },
      "./acl": {
        "types": "./dist/acl/index.d.ts",
        "import": "./dist/acl/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "preinstall": "node ./scripts/check-template-compatibility.mjs",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "test": "vitest run",
    "pack:check": "pnpm pack --out \"$PACK_DIR/nocobase-app-portal-sdk.tgz\" && pnpm exec publint . && pnpm exec attw \"$PACK_DIR/nocobase-app-portal-sdk.tgz\" --profile esm-only"
  },
  "dependencies": {
    "ignore": "catalog:",
    "i18next": "^25.3.2",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "@refinedev/core": "^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-router": "^7.0.0",
    "vite": ">=6.0.0 <8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@refinedev/core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "^7.7.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
