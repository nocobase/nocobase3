{
  "name": "@nocobase/app-plugin-ai-knowledge-base",
  "displayName": "AI Knowledge Base App Plugin",
  "description": "Knowledge base, document segmentation, and PGVector integration for NocoBase Apps.",
  "version": "0.0.1",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "client",
    "database",
    "server",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/bootstrap": {
      "types": "./client/bootstrap.ts",
      "import": "./client/bootstrap.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./client/vector-databases": {
      "types": "./client/vector-databases.ts",
      "import": "./client/vector-databases.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/bootstrap": {
        "types": "./dist/client/bootstrap.d.ts",
        "import": "./dist/client/bootstrap.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./client/vector-databases": {
        "types": "./dist/client/vector-databases.d.ts",
        "import": "./dist/client/vector-databases.js"
      },
      "./package.json": "./package.json"
    }
  },
  "nocobase": {
    "plugin": {
      "client": {
        "bootstrap": "./client/bootstrap",
        "routes": "./client/routes"
      },
      "database": {
        "migrations": "database/migrations"
      },
      "server": "./server/bootstrap.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "peerDependencies": {
    "@nocobase/app-client": "workspace:^",
    "@refinedev/core": "^5.0.0",
    "react": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@langchain/community": "1.1.29",
    "@langchain/core": "1.1.49",
    "@langchain/textsplitters": "1.0.1",
    "@nocobase/ai-employee": "workspace:^",
    "@nocobase/app-database": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-ai-employee": "workspace:^",
    "@nocobase/app-portal-sdk": "workspace:^",
    "@nocobase/app-server-kit": "workspace:^",
    "@nocobase/drive": "workspace:^",
    "@nocobase/queue": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "catalog:",
    "lucide-react": "^0.487.0",
    "nanoid": "^3.3.18",
    "pg": "^8.23.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.25.76",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@nocobase/app-client": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/yauzl": "^2.10.3",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
