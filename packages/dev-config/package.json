{
  "name": "@nocobase/dev-config",
  "version": "0.1.0",
  "description": "Shared TypeScript, ESLint, Prettier, Vitest, and Vite configuration for NocoBase packages.",
  "type": "module",
  "sideEffects": [
    "./vitest/react-setup.js"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase3.git",
    "directory": "packages/dev-config"
  },
  "files": [
    "README.md",
    "docs",
    "eslint",
    "prettier",
    "scripts",
    "tsconfig",
    "vite",
    "vitest"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/client.json": "./tsconfig/client.json",
    "./tsconfig/client-library.json": "./tsconfig/client-library.json",
    "./tsconfig/server.json": "./tsconfig/server.json",
    "./tsconfig/server-library.json": "./tsconfig/server-library.json",
    "./tsconfig/node-tooling.json": "./tsconfig/node-tooling.json",
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "import": "./eslint/index.js"
    },
    "./prettier": {
      "types": "./prettier/index.d.ts",
      "import": "./prettier/index.js"
    },
    "./vitest/node": {
      "types": "./vitest/node.d.ts",
      "import": "./vitest/node.js"
    },
    "./vitest/react": {
      "types": "./vitest/react.d.ts",
      "import": "./vitest/react.js"
    },
    "./vitest/react-setup": {
      "types": "./vitest/react-setup.d.ts",
      "import": "./vitest/react-setup.js"
    },
    "./vite/portal": {
      "types": "./vite/portal.d.ts",
      "import": "./vite/portal.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm lint:fix && pnpm format",
    "check": "pnpm lint && pnpm format:check",
    "pack:check": "node ./scripts/pack-check.mjs"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:"
  },
  "peerDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/vite": {
      "optional": true
    },
    "@testing-library/jest-dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
