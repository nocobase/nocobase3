{
  "name": "@nocobase/app-plugin-repository-example",
  "displayName": "Repository Example App Plugin",
  "description": "CRM and order management demonstrating relational Repository HTTP APIs.",
  "version": "0.0.1",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/providers": {
      "types": "./client/providers/index.ts",
      "import": "./client/providers/index.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "database",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/providers": {
        "types": "./dist/client/providers/index.d.ts",
        "import": "./dist/client/providers/index.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "hono": "catalog:"
  },
  "peerDependencies": {
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@nocobase/api-client": "workspace:*",
    "@nocobase/app-client": "workspace:*",
    "@nocobase/app-plugin-authentication": "workspace:*",
    "@nocobase/app-server": "workspace:*",
    "@nocobase/db": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/i18n": "workspace:*",
    "@nocobase/service-provider": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "better-sqlite3": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "lucide-react": "^0.487.0",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.2.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
