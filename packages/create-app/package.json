{
  "name": "@nocobase/create-app",
  "version": "0.1.0-beta.4",
  "description": "Create a NocoBase 3 application.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "create-app": "./bin/run.js"
  },
  "exports": {
    ".": {
      "types": "./src/create.ts",
      "import": "./src/create.ts"
    },
    "./flags": {
      "types": "./src/lib/flags.ts",
      "import": "./src/lib/flags.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "test": "vitest run",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --out \"$PACK_DIR/nocobase-create-app.tgz\" && pnpm exec publint ."
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@oclif/core": "catalog:"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/create.d.ts",
        "import": "./dist/create.js"
      },
      "./flags": {
        "types": "./dist/lib/flags.d.ts",
        "import": "./dist/lib/flags.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase3.git",
    "directory": "packages/create-app"
  },
  "license": "Apache-2.0"
}
