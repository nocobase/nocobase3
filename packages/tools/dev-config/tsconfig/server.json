{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NocoBase Node application",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "sourceMap": true,
    "noEmit": false
  }
}
