{
  "extends": "@nocobase/dev-config/tsconfig/server-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "index.ts",
    "bin/**/*.ts",
    "build/**/*.ts",
    "client/**/*.ts",
