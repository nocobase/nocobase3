{
  "name": "@nocobase/app-plugin-workflow",
  "displayName": "Workflow App Plugin",
  "description": "Adds workflow runtime, persistence, and HTTP APIs to a NocoBase app.",
  "version": "0.1.0-beta.2",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "workflow": "./dist/bin/workflow.js"
  },
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./build": {
      "types": "./build/index.ts",
      "import": "./build/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server/plugin": {
      "source": "./server/plugin.ts",
      "types": "./server/plugin.ts",
      "import": "./server/plugin.ts"
    },
    "./server/config": {
      "types": "./server/config.ts",
      "import": "./server/config.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./build": {
        "types": "./dist/build/index.d.ts",
        "import": "./dist/build/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server/plugin": {
        "types": "./dist/server/plugin.d.ts",
        "import": "./dist/server/plugin.js"
      },
      "./server/config": {
        "types": "./dist/server/config.d.ts",
        "import": "./dist/server/config.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "registry",
    "registry.config.json",
    "public/r",
    "skills"
  ],
  "nocobase": {
    "registry": {
      "items": {
        "workflow-management": "./registry/workflow-management"
      }
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json && tsc -p tsconfig.migrations.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.migrations.json --noEmit && tsc -p tsconfig.skill-evals.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "registry:build": "node ../../scripts/registry.mjs build --package .",
    "registry:materialize": "node ../../scripts/registry.mjs materialize --package .",
    "prepack": "pnpm registry:build",
    "eval:skill": "node --import tsx skill-evals/nocobase3-workflow-manage/runner/cli.ts",
    "eval:skill:test": "vitest run --config skill-evals/nocobase3-workflow-manage/vitest.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm registry:build && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/app-database": "workspace:^",
    "@nocobase/app-i18n": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-server-kit": "workspace:^",
    "@nocobase/drive": "workspace:^",
    "@nocobase/logging": "workspace:^",
    "@nocobase/queue": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "esbuild": "^0.25.12",
    "hono": "catalog:"
  },
  "peerDependencies": {
    "@nocobase/app-client": "workspace:^",
    "react": "^19.0.0",
    "react-router": "^7.0.2"
  },
  "devDependencies": {
    "@nocobase/app-client": "workspace:*",
    "@nocobase/app-sdk": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-router": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.8.1",
    "@boringnode/queue": "^0.7.1",
    "better-sqlite3": "^13.0.3",
    "knex": "^3.1.0"
  }
}
