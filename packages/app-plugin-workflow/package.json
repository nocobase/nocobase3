{
  "name": "@nocobase/app-plugin-workflow",
  "displayName": "Workflow App Plugin",
  "description": "Adds workflow runtime, persistence, and HTTP APIs to a NocoBase app.",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "workflow": "./dist/bin/workflow.js"
  },
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collections": {
      "source": "./server/collections/index.ts",
      "types": "./dist/server/collections/index.d.ts",
      "import": "./dist/server/collections/index.js"
    },
    "./client": {
      "source": "./client/index.ts",
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./build": {
      "source": "./build/index.ts",
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js"
    },
    "./server": {
      "source": "./server/index.ts",
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./collections": {
        "types": "./dist/server/collections/index.d.ts",
        "import": "./dist/server/collections/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./build": {
        "types": "./dist/build/index.d.ts",
        "import": "./dist/build/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "nocobase": {
    "plugin": {
      "database": {
        "migrations": "./database/migrations",
        "seeds": "./database/seeds"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.migrations.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.migrations.json --noEmit && tsc -p tsconfig.skill-evals.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "eval:skill": "node --import tsx skill-evals/nocobase3-workflow-manage/runner/cli.ts",
    "eval:skill:test": "vitest run --config skill-evals/nocobase3-workflow-manage/vitest.config.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/app-server": "workspace:^",
    "@nocobase/database": "workspace:^",
    "@nocobase/drive": "workspace:^",
    "@nocobase/queue": "workspace:^",
    "esbuild": "^0.25.12",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.8.1",
    "@boringnode/queue": "^0.7.1",
    "better-sqlite3": "^13.0.3",
    "knex": "^3.1.0"
  }
}
