{
  "name": "@nocobase/nb3-cli",
  "version": "0.1.0-beta.1",
  "description": "NocoBase 3 command line tool.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "nb3": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "oclif": {
    "bin": "nb3",
    "dirname": "nb3",
    "topicSeparator": " ",
    "helpClass": "./dist/help/runtime-help.js",
    "additionalHelpFlags": [
      "-h"
    ],
    "helpOptions": {
      "flagSortOrder": "none"
    },
    "commands": {
      "strategy": "explicit",
      "target": "./dist/registry.js"
    },
    "topics": {
      "app": {
        "description": "Create, develop, and deploy business apps."
      },
      "app:plugin": {
        "description": "Manage the plugins an app uses."
      },
      "app:plugin:skills": {
        "description": "Synchronize the agent skills plugins ship."
      },
      "hub": {
        "description": "Manage a local hub that hosts deployed apps."
      }
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "test": "vitest run",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --out \"$PACK_DIR/nocobase-nb3-cli.tgz\" && pnpm exec publint ."
  },
  "dependencies": {
    "@oclif/core": "catalog:"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase3.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0"
}
