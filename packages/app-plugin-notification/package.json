{
  "name": "@nocobase/app-plugin-notification",
  "displayName": "Notification App Plugin",
  "description": "Provides the application notification runtime, storage, delivery, and logs.",
  "version": "0.0.2-beta.0",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server/plugin": {
      "types": "./server/plugin.ts",
      "import": "./server/plugin.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/bootstrap": {
      "types": "./client/bootstrap.ts",
      "import": "./client/bootstrap.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./package.json": "./package.json"
  },
  "nocobase": {
    "registry": {
      "items": {
        "logs-ui": "./registry/logs-ui"
      }
    },
    "plugin": {
      "database": {
        "migrations": "./database/migrations"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server/plugin": {
        "types": "./dist/server/plugin.d.ts",
        "import": "./dist/server/plugin.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/bootstrap": {
        "types": "./dist/client/bootstrap.d.ts",
        "import": "./dist/client/bootstrap.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "docs",
    "registry",
    "registry.config.json",
    "public/r"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "registry:build": "node ../../scripts/registry.mjs build --package .",
    "registry:materialize": "node ../../scripts/registry.mjs materialize --package .",
    "prepack": "pnpm registry:build && pnpm build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm registry:build && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@sinclair/typebox": "catalog:",
    "@nocobase/app-database": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-authorization": "workspace:^",
    "@nocobase/app-server-kit": "workspace:^",
    "@nocobase/logging": "workspace:^",
    "@nocobase/queue": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "hono": "catalog:",
    "lucide-react": "^0.487.0"
  },
  "peerDependencies": {
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-sdk": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@nocobase/app-client": "workspace:*",
    "@nocobase/app-sdk": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
