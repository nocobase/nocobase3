{
  "name": "@nocobase/app-plugin-notification",
  "displayName": "Notification App Plugin",
  "description": "Provides the application notification runtime, storage, delivery, and logs.",
  "version": "0.0.1",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nocobase": {
    "plugin": {
      "database": {
        "migrations": "./database/migrations"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/app-database": "workspace:^",
    "@nocobase/logging": "workspace:^",
    "@nocobase/queue": "workspace:^",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
