{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "noEmit": true
  },
  "include": [
    "index.ts",
    "protocol.ts",
    "server/**/*.ts",
    "client/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "tests/registry-component-ui.test.tsx",
    "tests/registry-page-provider.test.tsx"
  ]
}
