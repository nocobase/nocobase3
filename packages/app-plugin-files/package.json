{
  "name": "@nocobase/app-plugin-files",
  "displayName": "Files App Plugin",
  "description": "Managed file contracts and runtime for NocoBase applications.",
  "version": "0.0.1",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./client/route-contracts": {
      "types": "./client/route-contracts.ts",
      "import": "./client/route-contracts.ts"
    },
    "./components.json": "./components.json",
    "./registry.config.json": "./registry.config.json",
    "./protocol": {
      "types": "./protocol.ts",
      "import": "./protocol.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./client/route-contracts": {
        "types": "./dist/client/route-contracts.d.ts",
        "import": "./dist/client/route-contracts.js"
      },
      "./components.json": "./components.json",
      "./registry.config.json": "./registry.config.json",
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "import": "./dist/protocol.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "components.json",
    "registry",
    "registry.config.json",
    "public/r",
    "!dist/server/internal/**/*.d.ts",
    "!dist/server/internal/**/*.d.ts.map"
  ],
  "nocobase": {
    "registry": {
      "items": {
        "component-ui": "./registry/component-ui",
        "page-ui": "./registry/page-ui",
        "provider-ui": "./registry/provider-ui"
      }
    },
    "plugin": {
      "client": {
        "routes": "./client/routes"
      },
      "database": {
        "migrations": "./database/migrations"
      }
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json && tsc -p tsconfig.migrations.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.migrations.json --noEmit && tsc -p tsconfig.registry.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "registry:build": "node ../../scripts/registry.mjs build --package .",
    "registry:materialize": "node ../../scripts/registry.mjs materialize --package .",
    "prepack": "pnpm registry:build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "pack:check": "pnpm pack --out \"$PACK_DIR/nocobase-app-plugin-files.tgz\" && pnpm exec publint .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm registry:build && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.577.0",
    "@aws-sdk/s3-request-presigner": "^3.577.0",
    "@nocobase/app-server-kit": "workspace:^",
    "@nocobase/app-database": "workspace:^",
    "@nocobase/app-sdk": "workspace:^",
    "@nocobase/queue": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flydrive": "^2.1.0",
    "hono": "catalog:",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@nocobase/app-client": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "better-sqlite3": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "knex": "catalog:",
    "lucide-react": "^0.487.0",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nocobase/app-client": "workspace:^",
    "react": "^19.0.0"
  }
}
