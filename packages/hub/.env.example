# Application
APP_NAME=hub
APP_BASE_PATH=/hub
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=13000

APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=3000

AUTH_SECRET=replace-with-at-least-32-random-characters
# Required when Hub is served from a non-loopback public origin.
# AUTH_BASE_URL=https://hub.example.com/hub/api/auth
HUB_DATABASE_PATH=.nocobase/hub.sqlite
HUB_SOURCE_ROOT=.nocobase/sources
HUB_RELEASE_ROOT=app-dist
APP_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Required outside loopback development. Generate an independent 32-byte key;
# never reuse AUTH_SECRET. A loopback Hub can instead persist an auto-generated
# key beside HUB_DATABASE_PATH or at HUB_SECRET_ENCRYPTION_KEY_FILE.
# HUB_SECRET_ENCRYPTION_KEY=
# HUB_SECRET_ENCRYPTION_KEY_FILE=.nocobase/runtime-secret.key
# HUB_MAX_UPLOAD_BYTES=536870912
# HUB_MAX_ARTIFACT_BYTES=2147483648
# HUB_UPLOAD_TTL_SECONDS=86400

# Optional external API proxy. The proxy is disabled unless both values are set.
# NOCOBASE_API_PROXY_TARGET=http://127.0.0.1:14000/api
# NOCOBASE_API_PROXY_PATH=/external-api

# Optional browser API client storage settings.
# API_CLIENT_STORAGE_PREFIX=NOCOBASE_
# API_CLIENT_STORAGE_TYPE=localStorage
# API_CLIENT_SHARE_TOKEN=false
