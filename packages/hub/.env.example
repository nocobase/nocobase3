APP_NAME=hub
APP_BASE_PATH=/hub
APP_SERVER_PORT=13001

# V3 native authentication and database. AUTH_SECRET is mandatory in production.
# Generate a unique high-entropy value and keep it out of source control.
# AUTH_SECRET=
# NOCOBASE_AUTH_URL=https://hub.example.com/hub/api/auth
# HUB_DATABASE_PATH=./data/hub.sqlite

# When omitted, the first registered user is the bootstrap administrator.
# Set this before registration when the administrator identity is known.
# HUB_ADMIN_EMAILS=admin@example.com

# Optional V2 compatibility proxy. V3 native login, settings and release
# management do not require it.
# NOCOBASE_API_URL=/hub/v2/api
# NOCOBASE_API_PROXY_TARGET=http://127.0.0.1:13000/api

# App Host remains an internal service. Hub exposes its Apps through the same
# browser origin, so users never need this port or address.
APP_HOST_CONTROL_URL=http://127.0.0.1:13200
# APP_HOST_GATEWAY_URL=http://127.0.0.1:13200
# APP_HOST_CONTROL_TOKEN=

# V3 preview stores release audit records locally with atomic writes.
# HUB_RELEASE_STORE_PATH=./data/release-management.json

# Settings are App-isolated and credentials are encrypted before persistence.
# HUB_SETTINGS_STORE_PATH=./data/settings.json
# HUB_SETTINGS_ENCRYPTION_KEY=
