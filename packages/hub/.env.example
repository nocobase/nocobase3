# Application
APP_NAME=hub
APP_BASE_PATH=/hub
APP_SERVER_PORT=13001

# V3 native authentication and database. AUTH_SECRET is mandatory in production.
# Generate a unique high-entropy value and keep it out of source control.
# AUTH_SECRET=
# NOCOBASE_AUTH_URL=https://hub.example.com/hub/api/auth
# HUB_DATABASE_PATH=./data/hub.sqlite

# When omitted, the first registered user is the bootstrap administrator.
# Set this before registration when the administrator identity is known.
# HUB_ADMIN_EMAILS=admin@example.com

# Optional V2 compatibility proxy. V3 native login, settings, and release
# management do not require it. The /api suffix is required for the upstream.
# NOCOBASE_API_URL=/hub/v2/api
# NOCOBASE_API_PROXY_TARGET=http://127.0.0.1:13000/api

# Keep these aligned with the main NocoBase frontend when customized.
# API_CLIENT_STORAGE_PREFIX=NOCOBASE_
# API_CLIENT_STORAGE_TYPE=localStorage
# API_CLIENT_SHARE_TOKEN=false

# By default Hub owns and starts an App Host child process. It reads immutable
# releases from ./app-dist and exposes managed Apps through the same browser
# origin, so users never need the App Host port or address.
# APP_DIST_DIR=./app-dist
# APP_HOST_PORT=13010
# Source development uses the tsx driver; production defaults to compiled Node.js.
# APP_HOST_DRIVER=tsx
# In cluster mode, set APP_HOST_URL to an independently deployed App Host.
# APP_HOST_URL=http://127.0.0.1:13200
# APP_HOST_CONTROL_URL=http://127.0.0.1:13200
# APP_HOST_GATEWAY_URL=http://127.0.0.1:13200
# APP_HOST_CONTROL_TOKEN=
# Hub keeps short control requests bounded separately; large artifact uploads default to 5 minutes.
# HUB_APP_HOST_UPLOAD_TIMEOUT_MS=300000
# APP_HOST_MAX_RELEASE_ARCHIVE_BYTES=536870912
# APP_HOST_MAX_RELEASE_EXTRACTED_BYTES=1073741824
# APP_HOST_MAX_RELEASE_ENTRIES=100000

# V3 preview stores release audit records locally with atomic writes.
# HUB_RELEASE_STORE_PATH=./data/release-management.json

# Hub-owned empty App registrations. Source code remains in the user's Git repository.
# HUB_APP_STORE_PATH=./data/apps.json

# Required by `nb3 app deploy`. Use a unique high-entropy secret and pass the
# same value to the CLI through NOCOBASE_HUB_TOKEN or --token.
# HUB_DEPLOY_TOKEN=

# Settings are App-isolated and credentials are encrypted before persistence.
# HUB_SETTINGS_STORE_PATH=./data/settings.json
# HUB_SETTINGS_ENCRYPTION_KEY=
