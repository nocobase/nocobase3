{
  "name": "@nocobase/app-plugin-registry-example",
  "displayName": "UI Registry Example App Plugin",
  "description": "Example plugin demonstrating runtime UI and application-owned Registry UI.",
  "version": "0.0.1",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./client/route-contracts": {
      "types": "./client/route-contracts.ts",
      "import": "./client/route-contracts.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./client/route-contracts": {
        "types": "./dist/client/route-contracts.d.ts",
        "import": "./dist/client/route-contracts.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "registry",
    "registry.config.json",
    "public/r"
  ],
  "nocobase": {
    "registry": {
      "items": {
        "component-ui": "./registry/component-ui",
        "page-ui": "./registry/page-ui",
        "provider-ui": "./registry/provider-ui"
      }
    },
    "plugin": {
      "client": {
        "routes": "./client/routes"
      }
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "registry:build": "node ../../scripts/registry.mjs build --package .",
    "registry:materialize": "node ../../scripts/registry.mjs materialize --package .",
    "prepack": "pnpm registry:build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm registry:build && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@nocobase/app-client": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.13.1",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.2.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nocobase/app-client": "workspace:^",
    "react": "^19.0.0"
  }
}
