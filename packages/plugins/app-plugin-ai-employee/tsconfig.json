{
  "extends": "@nocobase/dev-config/tsconfig/server-library.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "jsx": "react-jsx",
    "isolatedDeclarations": false,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "index.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "ai/**/*.ts",
    "server/**/*.ts",
    "database/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "client/dev"]
}
