{
  "name": "@nocobase/app-plugin-authorization",
  "displayName": "Authorization App Plugin",
  "description": "Authorization integration and permission management UI for NocoBase applications.",
  "version": "0.2.0-beta.5",
  "type": "module",
  "sideEffects": false,
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./client/react-providers": {
      "types": "./client/react-providers.ts",
      "import": "./client/react-providers.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./client/react-providers": {
        "types": "./dist/client/react-providers.d.ts",
        "import": "./dist/client/react-providers.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm build",
    "pack:check": "pnpm pack --out \"$PACK_DIR/nocobase-app-plugin-authorization.tgz\" && pnpm exec publint .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/authorization": "workspace:^",
    "hono": "catalog:"
  },
  "peerDependencies": {
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@nocobase/app-client": "workspace:*",
    "@nocobase/app-plugin-authentication": "workspace:*",
    "@nocobase/app-server": "workspace:*",
    "@nocobase/db": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/service-provider": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "lucide-react": "^0.487.0",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
