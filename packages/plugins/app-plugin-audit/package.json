{
  "name": "@nocobase/app-plugin-audit",
  "displayName": "Audit App Plugin",
  "description": "Operation audit storage, collectors, settings, and views with explicit application integration.",
  "version": "0.0.1",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server/tokens": {
      "types": "./server/tokens.ts",
      "import": "./server/tokens.ts"
    },
    "./package.json": "./package.json",
    "./server/contracts": {
      "types": "./server/contracts.ts",
      "import": "./server/contracts.ts"
    },
    "./client/contracts": {
      "types": "./client/contracts.ts",
      "import": "./client/contracts.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/components": {
      "types": "./client/components/index.ts",
      "import": "./client/components/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "skills",
    "registry",
    "registry.config.json",
    "public/r"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server/tokens": {
        "types": "./dist/server/tokens.d.ts",
        "import": "./dist/server/tokens.js"
      },
      "./package.json": "./package.json",
      "./server/contracts": {
        "types": "./dist/server/contracts.d.ts",
        "import": "./dist/server/contracts.js"
      },
      "./client/contracts": {
        "types": "./dist/client/contracts.d.ts",
        "import": "./dist/client/contracts.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/components": {
        "types": "./dist/client/components/index.d.ts",
        "import": "./dist/client/components/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm registry:build",
    "fix": "pnpm lint:fix && pnpm format",
    "test:integration:all": "AUDIT_TEST_DATABASES=sqlite,postgres,mysql vitest run --silent=false tests/integration/store-portable.test.ts tests/integration/multi-datasource.test.ts tests/integration/settings.test.ts tests/integration/settings-transaction.test.ts tests/unit/health.test.ts tests/integration/http.test.ts tests/integration/database-collector.test.ts tests/integration/database-faults.test.ts tests/integration/system-coupling.test.ts tests/integration/system-performance.test.ts",
    "registry:build": "node ../../../scripts/registry.mjs build --package .",
    "prepack": "pnpm registry:build"
  },
  "peerDependencies": {
    "@nocobase/app-server": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-authorization": "workspace:^",
    "@nocobase/app-client": "workspace:^",
    "@nocobase/i18n": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@nocobase/queue": "workspace:^",
    "@nocobase/app-plugin-install": "workspace:^",
    "@nocobase/app-plugin-i18n": "workspace:^",
    "@nocobase/app-plugin-notification": "workspace:^",
    "@nocobase/app-plugin-notification-in-app": "workspace:^",
    "@nocobase/app-plugin-workflow": "workspace:^",
    "@nocobase/app-plugin-ai-employee": "workspace:^"
  },
  "devDependencies": {
    "@nocobase/app-server": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/service-provider": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@nocobase/db": "workspace:*",
    "@nocobase/app-plugin-authentication": "workspace:*",
    "@nocobase/app-plugin-authorization": "workspace:*",
    "@nocobase/app-client": "workspace:*",
    "@nocobase/i18n": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "jsdom": "catalog:",
    "@base-ui/react": "^1.6.0",
    "@nocobase/queue": "workspace:*",
    "@nocobase/app-plugin-install": "workspace:*",
    "@nocobase/app-plugin-i18n": "workspace:*",
    "@nocobase/app-plugin-notification": "workspace:*",
    "@nocobase/app-plugin-notification-in-app": "workspace:*",
    "@nocobase/app-plugin-system-info": "workspace:*",
    "@nocobase/caching": "workspace:*",
    "@nocobase/logging": "workspace:*",
    "@nocobase/session": "workspace:*",
    "@nocobase/app-plugin-workflow": "workspace:*",
    "@nocobase/app-plugin-ai-employee": "workspace:*"
  },
  "dependencies": {
    "hono": "catalog:",
    "@sinclair/typebox": "catalog:",
    "@nocobase/cron": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nocobase/app-plugin-install": {
      "optional": true
    },
    "@nocobase/app-plugin-i18n": {
      "optional": true
    },
    "@nocobase/app-plugin-notification": {
      "optional": true
    },
    "@nocobase/app-plugin-notification-in-app": {
      "optional": true
    },
    "@nocobase/app-plugin-workflow": {
      "optional": true
    },
    "@nocobase/app-plugin-ai-employee": {
      "optional": true
    }
  },
  "nocobase": {
    "registry": {
      "items": {
        "events-panel": "./registry/events-panel"
      }
    }
  }
}
