{
  "name": "@nocobase/app-plugin-file",
  "displayName": "File App Plugin",
  "description": "Minimal file storage, access, route, and UI contracts for NocoBase applications.",
  "version": "0.1.0-beta.2",
  "type": "module",
  "sideEffects": false,
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/plugin": {
      "types": "./client/plugin.ts",
      "import": "./client/plugin.ts"
    },
    "./client/types": {
      "types": "./client/types.ts",
      "import": "./client/types.ts"
    },
    "./client/files-client": {
      "types": "./client/files-client.ts",
      "import": "./client/files-client.ts"
    },
    "./client/route-contracts": {
      "types": "./client/route-contracts.ts",
      "import": "./client/route-contracts.ts"
    },
    "./client/components": {
      "types": "./client/components/index.ts",
      "import": "./client/components/index.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/plugin": {
        "types": "./dist/client/plugin.d.ts",
        "import": "./dist/client/plugin.js"
      },
      "./client/types": {
        "types": "./dist/client/types.d.ts",
        "import": "./dist/client/types.js"
      },
      "./client/files-client": {
        "types": "./dist/client/files-client.d.ts",
        "import": "./dist/client/files-client.js"
      },
      "./client/route-contracts": {
        "types": "./dist/client/route-contracts.d.ts",
        "import": "./dist/client/route-contracts.js"
      },
      "./client/components": {
        "types": "./dist/client/components/index.d.ts",
        "import": "./dist/client/components/index.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "components.json",
    "database",
    "skills",
    "registry",
    "registry.config.json",
    "public/r"
  ],
  "nocobase": {
    "registry": {
      "items": {
        "component-ui": "./registry/component-ui",
        "page-ui": "./registry/page-ui"
      }
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "registry:build": "node ../../../scripts/registry.mjs build --package .",
    "registry:materialize": "node ../../../scripts/registry.mjs materialize --package .",
    "prepack": "pnpm registry:build && pnpm build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm registry:build && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@nocobase/drive": "workspace:^",
    "@nocobase/logging": "workspace:^",
    "@nocobase/session": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "catalog:",
    "lucide-react": "^0.487.0",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:",
    "tailwind-merge": "^3.2.0"
  },
  "peerDependencies": {
    "@nocobase/app-client": "workspace:^",
    "@nocobase/app-plugin-authentication": "workspace:^",
    "@nocobase/app-plugin-authorization": "workspace:^",
    "@nocobase/app-portal-sdk": "workspace:^",
    "@nocobase/app-server": "workspace:^",
    "@nocobase/db": "workspace:^",
    "@nocobase/service-provider": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@nocobase/app-client": "workspace:*",
    "@nocobase/app-plugin-authentication": "workspace:*",
    "@nocobase/app-plugin-authorization": "workspace:*",
    "@nocobase/app-portal-sdk": "workspace:*",
    "@nocobase/app-server": "workspace:*",
    "@nocobase/db": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@nocobase/service-provider": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.13.1",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.2.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
