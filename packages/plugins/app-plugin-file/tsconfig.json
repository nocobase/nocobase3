{
  "extends": "@nocobase/dev-config/tsconfig/server-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./client/*"]
    },
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "server/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "../../app/app-portal-sdk/src/env.d.ts"
  ],
  "exclude": ["tests", "registry"]
}
