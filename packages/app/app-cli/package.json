{
  "name": "@nocobase/app-cli",
  "version": "0.1.0-beta.4",
  "description": "Shared application runtime CLI commands.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "prettier": "@nocobase/dev-config/prettier",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./hub-publishing": {
      "types": "./src/hub-publishing.ts",
      "import": "./src/hub-publishing.ts",
      "default": "./src/hub-publishing.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./hub-publishing": {
        "types": "./dist/hub-publishing.d.ts",
        "import": "./dist/hub-publishing.js",
        "default": "./dist/hub-publishing.js"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase3.git",
    "directory": "packages/app/app-cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "vitest": "catalog:",
    "@nocobase/db-sqlite": "workspace:^"
  },
  "peerDependencies": {
    "@nocobase/app-server": "workspace:^",
    "@nocobase/nb3-cli": "workspace:^",
    "@nocobase/db": "workspace:^"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@oclif/core": "catalog:",
    "yaml": "catalog:"
  }
}
