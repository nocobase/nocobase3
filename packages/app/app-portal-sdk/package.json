{
  "name": "@nocobase/app-portal-sdk",
  "version": "1.0.0-beta.3",
  "description": "Stable runtime and extension APIs for NocoBase Portal applications.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/portal-template-default.git",
    "directory": "packages/app/app-portal-sdk"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts"
    },
    "./routing": {
      "types": "./src/routing/index.ts",
      "import": "./src/routing/index.ts"
    }
  },
  "nocobase": {
    "supportedDefaultTemplateRange": ">=3.0.0 <4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime/index.d.ts",
        "import": "./dist/runtime/index.js"
      },
      "./routing": {
        "types": "./dist/routing/index.d.ts",
        "import": "./dist/routing/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "test": "vitest run",
    "pack:check": "pnpm pack --out \"$PACK_DIR/nocobase-app-portal-sdk.tgz\" && pnpm exec publint . && pnpm exec attw \"$PACK_DIR/nocobase-app-portal-sdk.tgz\" --profile esm-only"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-router": "^7.0.0"
  }
}
