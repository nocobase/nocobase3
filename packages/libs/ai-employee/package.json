{
  "name": "@nocobase/ai-employee",
  "displayName": "AI Employee Core",
  "description": "Framework-neutral AI employee contracts, resource managers, loaders, providers, and helpers.",
  "version": "0.1.1-beta.0",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@langchain/anthropic": "1.3.17",
    "@langchain/classic": "1.0.34",
    "@langchain/community": "1.1.29",
    "@langchain/core": "1.1.49",
    "@langchain/deepseek": "1.0.27",
    "@langchain/google-genai": "2.1.18",
    "@langchain/langgraph": "1.4.4",
    "@langchain/langgraph-checkpoint": "1.1.2",
    "@langchain/mcp-adapters": "1.1.3",
    "@langchain/mistralai": "1.0.0",
    "@langchain/ollama": "1.2.7",
    "@langchain/openai": "1.4.7",
    "@langchain/xai": "1.3.19",
    "@nocobase/db": "workspace:^",
    "@nocobase/caching": "workspace:^",
    "@nocobase/logging": "workspace:^",
    "axios": "^1.7.0",
    "d3-dsv": "2",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "ipaddr.js": "^2.2.0",
    "jsonrepair": "^3.15.0",
    "langchain": "1.2.39",
    "lodash": "^4.17.21",
    "mammoth": "^1.10.0",
    "officeparser": "^6.0.4",
    "openai": "6.49.0",
    "pdf-parse": "^1.1.1",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5",
    "zod": "^3",
    "@nocobase/service-provider": "workspace:^"
  },
  "devDependencies": {
    "@nocobase/dev-config": "workspace:*",
    "@types/lodash": "^4.17.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
