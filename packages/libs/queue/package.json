{
  "name": "@nocobase/queue",
  "version": "0.1.0-beta.7",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && nocobase-db-manifests src/database dist/database",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "test:integration:cluster": "node scripts/test-integration.mjs cluster",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@boringnode/queue": "catalog:",
    "@nocobase/logging": "workspace:^",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation": "^0.200.0",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "knex": "catalog:"
  },
  "devDependencies": {
    "@nocobase/db-sqlite": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "eslint": "catalog:",
    "pg": "8.16.3",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nocobase/db": "workspace:^",
    "pg": ">=8.16.3 <9"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
