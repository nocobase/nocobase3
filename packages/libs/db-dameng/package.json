{
  "name": "@nocobase/db-dameng",
  "version": "0.0.1",
  "description": "Dameng dialect for @nocobase/db.",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run tests --exclude **/tests/integration/**",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:integration": "node --import tsx ./scripts/test-integration.ts"
  },
  "peerDependencies": {
    "@nocobase/db": "workspace:^"
  },
  "dependencies": {
    "dmdb": "^1.0.52452",
    "knex-dm": "^1.0.52452"
  },
  "devDependencies": {
    "@nocobase/db": "workspace:*",
    "@nocobase/db-testkit": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "knex": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
