{
  "name": "@nocobase/db",
  "version": "1.0.0-beta.2",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "example": "tsx ./examples/command.ts",
    "playground": "tsx ./playground/command.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db:up:postgres": "docker compose up -d --wait postgres",
    "test:db:up:mysql": "docker compose up -d --wait mysql",
    "test:db:up:oracle": "docker compose up -d --wait oracle",
    "test:db:up:mssql": "docker compose up -d --wait mssql && docker compose run --rm mssql-init",
    "test:db:up:all": "docker compose up -d --wait postgres mysql oracle mssql && docker compose run --rm mssql-init",
    "test:db:down": "docker compose down --volumes --remove-orphans",
    "test:integration": "pnpm test:integration:sqlite",
    "test:integration:sqlite": "INTEGRATION_DB_CONNECTIONS=sqlite vitest run tests/integration",
    "test:integration:postgres": "INTEGRATION_DB_CONNECTIONS=postgres vitest run tests/integration",
    "test:integration:mysql": "INTEGRATION_DB_CONNECTIONS=mysql vitest run tests/integration",
    "test:integration:oracle": "INTEGRATION_DB_CONNECTIONS=oracle vitest run tests/integration",
    "test:integration:mssql": "INTEGRATION_DB_CONNECTIONS=mssql vitest run tests/integration",
    "test:integration:all": "INTEGRATION_DB_CONNECTIONS=all vitest run tests/integration",
    "api:check": "node ./scripts/check-public-api.mjs",
    "api:update": "node ./scripts/check-public-api.mjs --write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p examples/tsconfig.json --noEmit",
    "typecheck:playground": "tsc -p playground/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm api:check && pnpm typecheck:examples && pnpm typecheck:playground && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/service-provider": "workspace:^",
    "knex": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "better-sqlite3": "catalog:",
    "eslint": "catalog:",
    "hono": "catalog:",
    "mysql2": "^3.23.3",
    "oracledb": "catalog:",
    "pg": "^8.23.0",
    "tedious": "catalog:",
    "tsx": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
