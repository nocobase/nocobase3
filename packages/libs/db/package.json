{
  "name": "@nocobase/db",
  "version": "1.0.0-beta.4",
  "type": "module",
  "prettier": "@nocobase/dev-config/prettier",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/src/index.js"
      },
      "./testing": {
        "types": "./dist/src/testing.d.ts",
        "import": "./dist/src/testing.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "example": "tsx ./examples/command.ts",
    "benchmark:numeric": "tsx ./benchmarks/numeric/run.ts",
    "typecheck:benchmarks": "tsc -p benchmarks/tsconfig.json --noEmit",
    "playground": "tsx ./playground/command.ts",
    "test": "vitest run tests --exclude **/tests/integration/**",
    "test:coverage": "vitest run --coverage",
    "test:db:up:postgres": "docker compose up -d --wait postgres",
    "test:db:up:mysql": "docker compose up -d --wait mysql",
    "test:db:up:oracle": "docker compose up -d --wait oracle",
    "test:db:up:mssql": "docker compose up -d --wait mssql && docker compose run --rm mssql-init",
    "test:db:up:dameng": "docker compose up -d --wait dameng",
    "test:db:up:all": "docker compose up -d --wait postgres mysql oracle mssql dameng && docker compose run --rm mssql-init",
    "test:db:down": "docker compose down --volumes --remove-orphans",
    "test:integration": "pnpm test:integration:sqlite",
    "test:integration:sqlite": "pnpm --filter @nocobase/db-sqlite test:integration",
    "test:integration:postgres": "pnpm --filter @nocobase/db-postgres test:integration",
    "test:integration:mysql": "pnpm --filter @nocobase/db-mysql test:integration",
    "test:integration:oracle": "pnpm --filter @nocobase/db-oracle test:integration",
    "test:integration:mssql": "pnpm --filter @nocobase/db-mssql test:integration",
    "test:integration:dameng": "pnpm --filter @nocobase/db-dameng test:integration",
    "test:integration:all": "pnpm test:integration:sqlite && pnpm test:integration:postgres && pnpm test:integration:mysql && pnpm test:integration:oracle && pnpm test:integration:mssql && pnpm test:integration:dameng",
    "api:check": "node ./scripts/check-public-api.mjs",
    "api:update": "node ./scripts/check-public-api.mjs --write",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p examples/tsconfig.json --noEmit",
    "typecheck:playground": "tsc -p playground/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm api:check && pnpm typecheck:examples && pnpm typecheck:playground && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format"
  },
  "dependencies": {
    "@nocobase/service-provider": "workspace:^",
    "knex": "catalog:",
    "@nocobase/repository-input": "workspace:^"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@nocobase/db-sqlite": "workspace:*",
    "@nocobase/db-dameng": "workspace:*",
    "@nocobase/db-testkit": "workspace:*",
    "@nocobase/dev-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "hono": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
