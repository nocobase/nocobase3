import { defineSeed, type SeedDefinition } from '@nocobase/app-database';

const seed: SeedDefinition = defineSeed({
  name: '202608290002_audit_log_create_welcome_record',

  async run({ query }) {
    await query
      .insertInto('appPluginAuditLogRecords')
      .values({
        name: 'Welcome from @nocobase/app-plugin-audit-log',
        createdAt: new Date(),
      })
      .execute();
  },
});

export default seed;
