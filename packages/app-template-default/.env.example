APP_NAME=main
APP_BASE_PATH=/main

# Browser-facing NocoBase REST API root. The app server proxies this path.
NOCOBASE_API_URL=/main/v2/api

# Upstream NocoBase REST API root (the /api suffix is required).
NOCOBASE_API_PROXY_TARGET=

# Keep these aligned with the main NocoBase frontend when customized.
# API_CLIENT_STORAGE_PREFIX=NOCOBASE_
# API_CLIENT_STORAGE_TYPE=localStorage
# API_CLIENT_SHARE_TOKEN=false
