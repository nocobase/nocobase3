# Application
APP_BASE_PATH=/main
# Public origin used for callbacks and redirects in production. Do not include
# the application path; APP_BASE_PATH is appended automatically.
# APP_PUBLIC_ORIGIN=https://apps.example.com

# Developer tooling
# Agent Annotations are enabled by default. Set this to false to disable them.
# AGENT_ANNOTATIONS_ENABLED=false

# Authentication
# The installation wizard generates AUTH_SECRET automatically. For manual
# setup, generate a unique secret (for example, `openssl rand -hex 32`) and
# uncomment the following line. Never commit the generated value.
# AUTH_SECRET=

# Database
# Supported dialects: sqlite, postgres, mysql.
DB_DIALECT=sqlite
DB_DATABASE=database.sqlite
DB_DEBUG=false

# PostgreSQL or MySQL connection settings. Their defaults depend on
# DB_DIALECT; uncomment and adjust them when using a server database.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=

# MySQL only.
# DB_CHARSET=utf8mb4

# PostgreSQL only. DB_SCHEMA accepts a comma-separated list.
# DB_SSL=false
# DB_SCHEMA=public

# Database lifecycle
DB_MIGRATIONS_AUTO_RUN=true
DB_SEEDS_AUTO_RUN=true

# Notification Providers
# Enable at most one Provider for each Channel. Leave the selector empty to
# keep that Channel disabled.
# NOTIFICATION_EMAIL_PROVIDER=smtp
# NOTIFICATION_IM_PROVIDER=feishu

# The provider test page is enabled by default outside production. Set this to
# false to disable it, or explicitly enable it in a controlled production
# environment. You must be signed in to use the page.
# NOTIFICATION_PROVIDER_TEST_ENABLED=true

# The email recipient is used by the provider test page and
# `pnpm notification:test`.
# TEST_EMAIL_RECIPIENT=recipient@example.com

# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=mailer@example.com
# SMTP_PASSWORD=
# SMTP_FROM=NocoBase <mailer@example.com>
# SMTP_REPLY_TO=

# Resend
# RESEND_API_KEY=
# RESEND_FROM=NocoBase <notifications@example.com>
# RESEND_REPLY_TO=

# Feishu custom bot
# FEISHU_WEBHOOK_URL=
# FEISHU_WEBHOOK_SECRET=

# DingTalk custom robot
# DINGTALK_WEBHOOK_URL=
# DINGTALK_WEBHOOK_SECRET=
