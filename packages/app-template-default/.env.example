# Application
APP_BASE_PATH=/main

# Optional for `pnpm dev`. If omitted, or if the port is busy, the dev
# script automatically selects an available application server port.
# APP_SERVER_PORT=13000

# Authentication
# The installation wizard generates AUTH_SECRET automatically. For manual
# setup, generate a unique secret (for example, `openssl rand -hex 32`) and
# uncomment the following line. Never commit the generated value.
# AUTH_SECRET=

# Public origin used for authentication callbacks.
# Keep the application path out of this value.
NOCOBASE_AUTH_URL=

# Database
# Supported dialects: sqlite, postgres, mysql.
DB_DIALECT=sqlite
DB_DATABASE=database.sqlite
DB_DEBUG=false

# PostgreSQL or MySQL connection settings. Their defaults depend on
# DB_DIALECT; uncomment and adjust them when using a server database.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=

# MySQL only.
# DB_CHARSET=utf8mb4

# PostgreSQL only. DB_SCHEMA accepts a comma-separated list.
# DB_SSL=false
# DB_SCHEMA=public

# Database lifecycle
DB_MIGRATIONS_AUTO_RUN=true
DB_SEEDS_AUTO_RUN=true

# Upstream NocoBase REST API root (the /api suffix is required).
NOCOBASE_API_PROXY_TARGET=

# Managed Files storage. Local is the default and stays under app-private data.
# FILES_STORAGE_DRIVER=local
# FILES_LOCAL_ROOT=/absolute/private/path
# FILES_S3_BUCKET=
# FILES_S3_REGION=
# FILES_S3_ENDPOINT=
# FILES_S3_PREFIX=
# FILES_S3_FORCE_PATH_STYLE=false
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_S3_SESSION_TOKEN=
# S3 browser uploads require this App Origin, PUT/OPTIONS, and allowed Upload
# Plan headers such as Content-Type. Text reads require GET/HEAD and
# exposed Content-Type, Content-Length, and Content-Disposition headers.
# FILES_UPLOAD_MAX_BYTES=52428800
# FILES_UPLOAD_EXPIRES_IN_SECONDS=900
# FILES_TEMPORARY_ACCESS_EXPIRES_IN_SECONDS=300
# FILES_PROVIDER_URL_EXPIRES_IN_SECONDS=60
# FILES_PUBLIC_ACCESS_ENABLED=false

# Keep these aligned with the main NocoBase frontend when customized.
# API_CLIENT_STORAGE_PREFIX=NOCOBASE_
# API_CLIENT_STORAGE_TYPE=localStorage
# API_CLIENT_SHARE_TOKEN=false
