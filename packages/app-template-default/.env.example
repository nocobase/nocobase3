APP_BASE_PATH=/main

# Public origin used for authentication callbacks.
# Keep the application path out of this value.
NOCOBASE_AUTH_URL=
AUTH_SECRET=

# Upstream NocoBase REST API root (the /api suffix is required).
NOCOBASE_API_PROXY_TARGET=

# Managed Files storage. Local is the default and stays under app-private data.
# FILES_STORAGE_DRIVER=local
# FILES_LOCAL_ROOT=/absolute/private/path
# FILES_S3_BUCKET=
# FILES_S3_REGION=
# FILES_S3_ENDPOINT=
# FILES_S3_PREFIX=
# FILES_S3_FORCE_PATH_STYLE=false
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_S3_SESSION_TOKEN=
# S3 browser uploads require this App Origin, PUT/OPTIONS, and allowed Upload
# Plan headers Content-Type and If-None-Match. Text reads require GET/HEAD and
# exposed Content-Type, Content-Length, and Content-Disposition headers.
# FILES_UPLOAD_MAX_BYTES=52428800
# FILES_UPLOAD_EXPIRES_IN_SECONDS=900
# FILES_TEMPORARY_ACCESS_EXPIRES_IN_SECONDS=300
# FILES_PROVIDER_URL_EXPIRES_IN_SECONDS=60
# FILES_PUBLIC_ACCESS_ENABLED=false

# Keep these aligned with the main NocoBase frontend when customized.
# API_CLIENT_STORAGE_PREFIX=NOCOBASE_
# API_CLIENT_STORAGE_TYPE=localStorage
# API_CLIENT_SHARE_TOKEN=false
