{
  "name": "@nocobase/app-template-default",
  "displayName": "Default Template",
  "version": "3.1.1",
  "type": "module",
  "exports": {
    "./server": {
      "source": "./server/index.ts",
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/workflow": {
      "source": "./server/workflow.ts",
      "types": "./dist/server/workflow.d.ts",
      "import": "./dist/server/workflow.js"
    },
    "./server/workflow-source": {
      "source": "./server/workflows/dsl.ts",
      "types": "./dist/server/workflows/dsl.d.ts",
      "import": "./dist/server/workflows/dsl.js"
    },
    "./server/migrations/app-settings": {
      "source": "./server/migrations/202608180001_create_app_settings_table.ts",
      "types": "./dist/server/migrations/202608180001_create_app_settings_table.d.ts",
      "import": "./dist/server/migrations/202608180001_create_app_settings_table.js"
    },
    "./server/migrations/workflow": {
      "source": "./server/migrations/202608200001_create_workflow_collections.ts",
      "types": "./dist/server/migrations/202608200001_create_workflow_collections.d.ts",
      "import": "./dist/server/migrations/202608200001_create_workflow_collections.js"
    }
  },
