  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/app-template-default.git"
  },
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "server:config": "tsx --tsconfig tsconfig.node.json ./scripts/server-config.ts",
    "build": "node ./scripts/build.mjs",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json && tsc -p tsconfig.migrations.json && tsc-alias -p tsconfig.migrations.json",
    "migrate": "tsx --tsconfig tsconfig.server.json ./scripts/migrate.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.migrations.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:sdk": "pnpm --filter @nocobase/portal-sdk test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install chromium",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:sdk && pnpm build && pnpm test:e2e",
    "start": "node ./dist/server/standalone.js",
    "refine": "refine",
    "sdk:check": "pnpm exec portal-sdk check"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
