{
  "extends": "@nocobase/dev-config/tsconfig/server-library.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@/jobs/*.js": ["./server/jobs/*.ts"],
      "@/jobs/*": ["./server/jobs/*"],
      "@/services/*.js": ["./server/services/*.ts"],
      "@/services/*": ["./server/services/*"]
    }
  },
  "include": ["server/**/*.ts", "registry/notification/**/*.ts", "scripts/migrate.ts"],
  "exclude": [
    "server/migrations/**/*.ts",
    "registry/notification/admin/**/*.ts",
    "registry/notification/inbox/**/*.ts"
  ]
}
