{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "isolatedDeclarations": true,
    "isolatedModules": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@/jobs/*.js": ["./server/jobs/*.ts"],
      "@/jobs/*": ["./server/jobs/*"],
      "@/services/*.js": ["./server/services/*.ts"],
      "@/services/*": ["./server/services/*"]
    },
    "noEmit": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server/**/*.ts", "registry/notification/**/*.ts", "scripts/migrate.ts"],
  "exclude": ["server/migrations/**/*.ts", "registry/notification/admin/**/*.ts"]
}
