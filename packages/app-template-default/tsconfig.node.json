{
  "extends": "@nocobase/dev-config/tsconfig/node-tooling.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "paths": {
      "@/jobs/*.js": ["./server/jobs/*.ts"],
      "@/jobs/*": ["./server/jobs/*"],
      "@/services/*.js": ["./server/services/*.ts"],
      "@/services/*": ["./server/services/*"]
    }
  },
  "include": ["vite.config.ts", "scripts/*.ts"]
}
