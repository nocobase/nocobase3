  "files": [
    ".prettierignore",
    "cli",
    "client",
    "server",
    "database",
    "public",
    "scripts",
    "index.html",
    "components.json",
    "tailwind.config.mjs",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "tsconfig.json",
    "tsconfig.node.json",
    "tsconfig.server.json",
    "ecosystem.config.js",
    "config.example.yml",
    "README.MD",
    "MIGRATION.md",
    "AGENTS.md",
    "CLAUDE.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase3.git",
    "directory": "packages/templates/app-template-examples"
  },
  "scripts": {
    "dev": "tsx ./scripts/dev/index.mjs",
    "build": "node ./scripts/build.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "migrate": "pnpm nocobase app migrate",
    "seed": "pnpm nocobase app seed",
    "nocobase": "tsx ./cli/index.ts",
    "plugin:register": "nocobase plugin register",
    "plugin:inspect": "nocobase plugin inspect",
    "plugin:unregister": "nocobase plugin unregister",
    "plugin:update": "nocobase plugin update",
    "plugin:skills:sync": "nocobase plugin skills sync",
    "client:inspect": "pnpm nocobase app inspect client",
    "server:inspect": "pnpm nocobase app inspect server",
    "server:deps:inspect": "node ./scripts/utils/inspect-server-deps.mjs",
    "server:deps:prune": "node ./scripts/utils/prune-server-deps.mjs",
    "server:deps:retarget": "node ./scripts/utils/retarget-native.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm typecheck && pnpm test && pnpm build",
    "start": "node ./scripts/start.mjs",
    "refine": "refine",
    "pack:check": "pnpm pack --out \"$PACK_DIR/nocobase-app-template-examples.tgz\" && pnpm exec publint ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@nocobase/app-plugin-repository-example": "workspace:^"
  },
  "description": "Runnable NocoBase 3 examples for application development.",
  "license": "Apache-2.0"
}
