# Local application configuration
/config.yml

# Written by `pnpm nocobase collections generate` for each managed connection: a snapshot of what this machine's database
# resolves every Collection to, down to the dialect's physical types. It describes a database rather than the
# application, so it is regenerated after migrating rather than committed. An `external` connection is the exception —
# there `metadata.json` is the metadata source and belongs in the repository — so the managed connections are named
# one by one rather than ignoring `database/*/collections/`.
/database/main/collections/
/database/analytics/collections/

# Local SQLite database, at the path config.example.yml gives the default connection
/database.sqlite
/database.sqlite-journal
/database.sqlite-wal
/database.sqlite-shm

