[
  {
    "name": "anthropic",
    "title": "Anthropic Claude",
    "provider": "anthropic",
    "options": {
      "apiKey": "${ANTHROPIC_API_KEY}"
    },
    "enabledModels": [
      "claude-3-5-sonnet-20241022",
      "claude-3-5-haiku-20241022"
    ],
    "enabled": false
  },
  {
    "name": "deepseek",
    "title": "DeepSeek",
    "provider": "deepseek",
    "options": {
      "apiKey": "${DEEPSEEK_API_KEY}"
    },
    "enabledModels": ["deepseek-v4-flash"],
    "enabled": true
  },
  {
    "name": "dashscope",
    "title": "Dashscope",
    "provider": "dashscope",
    "options": {
      "apiKey": "${DASHSCOPE_API_KEY}"
    },
    "enabledModels": ["qwen-plus", "text-embedding-v4"],
    "enabled": true
  },
  {
    "name": "ollama",
    "title": "Ollama (local)",
    "provider": "ollama",
    "options": {
      "baseURL": "http://127.0.0.1:11434/v1"
    },
    "enabledModels": ["qwen2.5", "llama3.1"],
    "enabled": false
  },
  {
    "name": "openai",
    "title": "OpenAI",
    "provider": "openai",
    "options": {
      "apiKey": "${OPENAI_API_KEY}",
      "baseURL": "${OPENAI_BASE_URL}"
    },
    "enabledModels": ["gpt-4o", "gpt-4.1", "gpt-4o-mini"],
    "enabled": false
  }
]
