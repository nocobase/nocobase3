  "files": [
    ".prettierignore",
    "cli",
    "client",
    "server",
    "database/tsconfig.json",
    "database/*/migrations/**",
    "database/*/seeds/**",
    "public",
    "scripts",
    "tests",
    "index.html",
    "components.json",
    "tailwind.config.mjs",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "tsconfig.json",
    "tsconfig.node.json",
    "tsconfig.server.json",
    "ecosystem.config.js",
    "config.example.yml",
    "README.MD",
    "AGENTS.md",
    "CLAUDE.md",
    "playwright.config.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocobase/nocobase3.git",
    "directory": "packages/templates/app-template-default"
  },
  "scripts": {
    "dev": "node --import tsx ./scripts/dev.mjs",
    "build": "node ./scripts/build.mjs",
    "start": "node ./scripts/start.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "fix": "pnpm lint:fix && pnpm format",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "nocobase": "tsx ./cli/index.ts",
    "collections:generate": "tsx ./cli/index.ts app collections generate",
    "db:apply": "tsx ./cli/index.ts app db apply",
    "db:reset": "tsx ./cli/index.ts app db reset",
    "db:repair": "tsx ./cli/index.ts app db repair",
    "plugin:register": "nocobase plugin register",
    "plugin:inspect": "nocobase plugin inspect",
    "plugin:unregister": "nocobase plugin unregister",
    "plugin:update": "nocobase plugin update",
    "package:remove": "nocobase package remove",
    "skills:sync": "nocobase skills sync",
    "upload": "tsx ./cli/index.ts app upload",
    "deploy": "tsx ./cli/index.ts app deploy",
    "server:deps:retarget": "node ./scripts/server-deps.mjs retarget",
    "server:deps:verify": "node ./scripts/server-deps.mjs verify"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "zod": "catalog:",
    "@nocobase/app-plugin-ai-employee": "workspace:^",
