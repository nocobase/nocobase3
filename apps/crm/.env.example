APP_NAME=crm
APP_BASE_PATH=/crm

# V3 native runtime. The browser API is always <APP_BASE_PATH>/api.
# CRM_DATABASE_PATH=./data/crm.sqlite
# CRM_DATA_DIR=./data
# AUTH_SECRET=replace-with-a-long-random-production-secret
# NOCOBASE_AUTH_URL=https://crm.example.com/crm/api/auth
# CRM_ALLOW_ADDITIONAL_SIGN_UP=false

# Keep these aligned with the main NocoBase frontend when customized.
# API_CLIENT_STORAGE_PREFIX=NOCOBASE_
