{
  "name": "agent_crm_activities",
  "title": "CRM Activities",
  "description": "Calls, meetings, emails, and follow-up tasks for the sales team.",
  "template": "general",
  "fields": [
    {
      "name": "subject",
      "title": "Subject",
      "interface": "input",
      "validators": ["required", { "name": "max", "args": { "limit": 180 } }]
    },
    {
      "name": "type",
      "title": "Activity type",
      "interface": "select",
      "validators": ["required"],
      "enum": [
        { "value": "call", "label": "Call", "color": "blue" },
        { "value": "meeting", "label": "Meeting", "color": "purple" },
        { "value": "email", "label": "Email", "color": "green" },
        { "value": "task", "label": "Task", "color": "gold" }
      ],
      "defaultValue": "task"
    },
    {
      "name": "status",
      "title": "Activity status",
      "interface": "select",
      "validators": ["required"],
      "enum": [
        { "value": "planned", "label": "Planned", "color": "blue" },
        { "value": "completed", "label": "Completed", "color": "green" },
        { "value": "cancelled", "label": "Cancelled", "color": "default" }
      ],
      "defaultValue": "planned"
    },
    {
      "name": "dueAt",
      "title": "Due at",
      "interface": "datetime",
      "validators": ["required"]
    },
    { "name": "notes", "title": "Follow-up notes", "interface": "textarea" }
  ]
}
