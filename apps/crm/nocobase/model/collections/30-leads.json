{
  "name": "agent_crm_leads",
  "title": "CRM Leads",
  "description": "Incoming and outbound sales leads before conversion.",
  "template": "general",
  "fields": [
    {
      "name": "code",
      "title": "Lead number",
      "interface": "sequence",
      "patterns": [
        {
          "type": "string",
          "options": { "value": "LEAD-" }
        },
        {
          "type": "date",
          "options": { "format": "YYYYMM" }
        },
        {
          "type": "integer",
          "options": { "digits": 4, "start": 1, "cycle": null }
        }
      ],
      "inputable": false,
      "match": false
    },
    {
      "name": "name",
      "title": "Contact name",
      "interface": "input",
      "validators": ["required", { "name": "max", "args": { "limit": 120 } }]
    },
    {
      "name": "company",
      "title": "Company",
      "interface": "input",
      "validators": ["required", { "name": "max", "args": { "limit": 160 } }]
    },
    {
      "name": "status",
      "title": "Lead status",
      "interface": "select",
      "validators": ["required"],
      "enum": [
        { "value": "new", "label": "New", "color": "blue" },
        { "value": "contacted", "label": "Contacted", "color": "purple" },
        { "value": "qualified", "label": "Qualified", "color": "green" },
        { "value": "nurturing", "label": "Nurturing", "color": "gold" },
        { "value": "disqualified", "label": "Disqualified", "color": "default" }
      ],
      "defaultValue": "new"
    },
    {
      "name": "source",
      "title": "Lead source",
      "interface": "select",
      "enum": [
        { "value": "inbound", "label": "Website", "color": "blue" },
        { "value": "referral", "label": "Referral", "color": "green" },
        { "value": "event", "label": "Event", "color": "purple" },
        { "value": "outbound", "label": "Outbound", "color": "gold" },
        { "value": "partner", "label": "Partner", "color": "default" }
      ],
      "defaultValue": "inbound"
    },
    {
      "name": "score",
      "title": "Lead score",
      "interface": "integer",
      "validators": [
        { "name": "min", "args": { "limit": 0 } },
        { "name": "max", "args": { "limit": 100 } }
      ],
      "defaultValue": 50
    },
    {
      "name": "email",
      "title": "Email",
      "interface": "email",
      "validators": ["email"]
    },
    { "name": "phone", "title": "Phone", "interface": "phone" },
    { "name": "notes", "title": "Needs summary", "interface": "textarea" }
  ]
}
