# Playwright starts the Portal server on this port and Vite on the next port.
# NOCOBASE_E2E_PORT=4173
# NOCOBASE_E2E_VITE_PORT=4174

# Keep this aligned with the Portal path being tested.
# NOCOBASE_PORTAL_BASE=/x/demo/

# Point this at the real NocoBase backend used by the test.
# NOCOBASE_E2E_API_URL=http://127.0.0.1:13000/api

# Browser traffic stays same-origin through the Portal server proxy.
# NOCOBASE_E2E_BROWSER_API_URL=/crm/v2/api

# Reuse a locally installed browser when Playwright browsers are unavailable.
# NOCOBASE_E2E_BROWSER_CHANNEL=chrome

NOCOBASE_E2E_ACCOUNT=nocobase
NOCOBASE_E2E_PASSWORD=
NOCOBASE_E2E_AUTHENTICATOR=basic
# NOCOBASE_E2E_ROLE=admin
