{
  // Checks the registry sources the way a plugin compiles them after installation, against the real workspace
  // packages rather than the preview's mocks. NodeNext resolution is the point: a relative import without its `.js`
  // extension fails here instead of in the first plugin that installs the item.
  "extends": "@nocobase/dev-config/tsconfig/client-library.json",
  "compilerOptions": {
    "noEmit": true,
    // Declaration checks would also cover the preview's shadcn copies below, which do not annotate their exports, so
    // the explicit export types a plugin's declaration build requires are a rule in MAINTAINING.md instead.
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.registry.tsbuildinfo",
    "paths": {
      // Items import shadcn primitives the way an application provides them. The preview's copies stand in for
      // them; the explicit extension is what lets an extensionless alias resolve under NodeNext.
      "@/components/ui/*": ["./website/components/ui/*.tsx"]
    }
  },
  "include": ["registry/**/*.ts", "registry/**/*.tsx"]
}
