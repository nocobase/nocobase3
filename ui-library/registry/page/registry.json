{
  "items": [
    {
      "name": "page-ui",
      "type": "registry:block",
      "title": "Page UI",
      "description": "The page frame and heading every NocoBase page is built from.",
      "meta": {
        "group": "Pages",
        "iframeHeight": 560
      },
      "dependencies": ["tailwind-merge@^3.2.0"],
      "docs": "Wrap each page in PageContainer and open it with PageHeader. Content rendered inside another page, such as an inline child route or a tab panel, adds no PageContainer of its own.",
      "files": [
        {
          "path": "page-ui/components/page-container.tsx",
          "type": "registry:component",
          "target": "client/extensions/nocobase-page-ui/components/page-container.tsx"
        },
        {
          "path": "page-ui/components/page-header.tsx",
          "type": "registry:component",
          "target": "client/extensions/nocobase-page-ui/components/page-header.tsx"
        }
      ]
    },
    {
      "name": "route-overlay-ui",
      "type": "registry:block",
      "title": "Route Overlay UI",
      "description": "URL-addressable dialogs, drawers and covering child pages for child routes.",
      "meta": {
        "group": "Pages",
        "iframeHeight": 720
      },
      "dependencies": [
        "@base-ui/react@^1.6.0",
        "@nocobase/i18n@^1.0.0-beta.4",
        "lucide-react@^0.487.0",
        "react-router@^7.0.2",
        "tailwind-merge@^3.2.0"
      ],
      "registryDependencies": ["button", "dialog"],
      "docs": "Requires react-router and @nocobase/i18n. Render RouteDialog, RouteDrawer or RouteChildPage from the component of a child route, and call useRouteOverlay() only from inside the overlay. The close button is translated under routeOverlay.close and falls back to its English default; merge locales/en-US.ts and locales/zh-CN.ts into the locale resources of the namespace that renders the item.",
      "files": [
        {
          "path": "route-overlay-ui/components/route-overlay.tsx",
          "type": "registry:component",
          "target": "client/extensions/nocobase-route-overlay-ui/components/route-overlay.tsx"
        },
        {
          "path": "route-overlay-ui/components/route-dialog.tsx",
          "type": "registry:component",
          "target": "client/extensions/nocobase-route-overlay-ui/components/route-dialog.tsx"
        },
        {
          "path": "route-overlay-ui/components/route-drawer.tsx",
          "type": "registry:component",
          "target": "client/extensions/nocobase-route-overlay-ui/components/route-drawer.tsx"
        },
        {
          "path": "route-overlay-ui/components/route-child-page.tsx",
          "type": "registry:component",
          "target": "client/extensions/nocobase-route-overlay-ui/components/route-child-page.tsx"
        },
        {
          "path": "route-overlay-ui/hooks/use-route-overlay.ts",
          "type": "registry:hook",
          "target": "client/extensions/nocobase-route-overlay-ui/hooks/use-route-overlay.ts"
        },
        {
          "path": "route-overlay-ui/locales/en-US.ts",
          "type": "registry:lib",
          "target": "client/extensions/nocobase-route-overlay-ui/locales/en-US.ts"
        },
        {
          "path": "route-overlay-ui/locales/zh-CN.ts",
          "type": "registry:lib",
          "target": "client/extensions/nocobase-route-overlay-ui/locales/zh-CN.ts"
        }
      ]
    }
  ]
}
