# Copy to playground/.env for Docker Compose. Never commit .env.
# Non-secret Hub settings are in playground/config.yml.
# Use a published run-<run-id>-<attempt> tag or digest to pin a build.
NOCOBASE_IMAGE=ghcr.io/nocobase/hub:latest
# Alibaba Cloud mirror:
# NOCOBASE_IMAGE=registry.cn-beijing.aliyuncs.com/nocobase/hub:latest

# Local access by default. Use 0.0.0.0 to expose the port on other interfaces.
NOCOBASE_BIND_HOST=127.0.0.1
NOCOBASE_PORT=13000

# The browser-facing origin, without /hub. Update when changing the port or domain.
APP_PUBLIC_ORIGIN=http://localhost:13000

# Run `openssl rand -hex 32` twice and paste one result into each value.
# Keep these values unchanged across restarts and image updates.
AUTH_SECRET=
SESSION_SECRET=
